# ==============================================================================
# 前端应用领域专属过滤规则 (Frontend Domain-Specific Concerns)
# ==============================================================================

# 包管理器依赖 (Package Manager Dependencies)
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# 生产环境构建产物 (Build Output)
dist/
dist-ssr/

# 编译与构建缓存 (Vite & TypeScript Caches)
.vite/
.vue-tsc/
*.tsbuildinfo

# 前端本地私有环境变量 (Frontend Environment Configurations)
.env
.env.local
.env.*.local
