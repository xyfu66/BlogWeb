# ==============================================================================
# 全局基础设施与宿主环境过滤规则 (Global & Infrastructure Concerns)
# ==============================================================================

# 操作系统临时与索引文件 (OS System Artifacts)
.DS_Store
Thumbs.db
Desktop.ini

# 通用 IDE 与编辑器工作空间配置 (IDE & Editor Settings)
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# 诊断与系统临时目录
.cursor/
.kiro/
.codegraph/

# 根目录私有日志与临时文件
*.local
logs/
*.log
