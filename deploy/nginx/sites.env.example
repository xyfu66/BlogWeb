# 复制为 deploy/nginx/sites.env 后填写真实值（gitignore，严禁提交）
# 本机维护 SoT；Preflight 会安全 scp 至远端 $REMOTE_REPO_ROOT/deploy/nginx/sites.env

# 宿主机绑机域名（Nginx server_name 使用）
BLOG_DOMAIN=example.com

# 宿主机静态父根目录（Nginx root 使用，如 /var/www）
REMOTE_BLOG_WEB_ROOT=/var/www

# 博客静态发布目录（宿主机实际解压/部署路径，与 deploy/.env 中 REMOTE_BLOG_DIR 保持一致）
REMOTE_BLOG_DIR=/var/www/me/blog
