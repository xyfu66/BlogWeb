# 复制为 deploy/.env 后填写真实值（gitignore，勿提交）

# SSH 连接
SSH_HOST=your.server.com
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# 个人博客静态托管目录（宿主机 Nginx 目录；非 Docker）
REMOTE_BLOG_DIR=/var/www/me/blog

# 宿主机 Nginx 模块化配置目标路径（选填，默认 /etc/nginx/snippets/blog-web.conf）
REMOTE_NGINX_CONF_PATH=/etc/nginx/snippets/blog-web.conf
