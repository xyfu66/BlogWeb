# 复制为 deploy/.env 后填写真实值（gitignore，勿提交）

# SSH 连接
SSH_HOST=your.server.com
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# 远程路径
# REMOTE_REPO_ROOT：MusicStringStudioPro 宿主机仓库路径（用于调用已存在的 static-atomic-swap.sh）
REMOTE_REPO_ROOT=/opt/MusicStringStudioPro
REMOTE_BLOG_DIR=/var/www/me/blog

# 发布分支
GIT_REMOTE_BRANCH=main
