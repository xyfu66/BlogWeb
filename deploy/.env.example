# 复制为 deploy/.env 后填写真实值（gitignore，勿提交）

# SSH 连接
SSH_HOST=your.server.com
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# 个人博客静态托管目录（宿主机 Nginx 目录；非 Docker）
REMOTE_BLOG_DIR=/var/www/me/blog

# 远程仓库根（服务器上已 clone 的路径；首次上线须在服务器 git clone）
REMOTE_REPO_ROOT=/opt/BlogWeb

# 发布行为
GIT_REMOTE_BRANCH=master
DEPLOY_PROFILE=prod
